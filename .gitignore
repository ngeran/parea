# Dependencies
node_modules/

# Wrangler local state (D1, R2, DO simulation)
.wrangler/

# Local secrets — never commit
.dev.vars
.dev.vars.*

# Generated (recreate with `npm run types -w @together/server`)
apps/server/worker-configuration.d.ts

# Builds
dist/
build/
.expo/
*.tsbuildinfo
coverage/
# Admin build output — keep the directory itself (wrangler dev needs the
# assets directory to exist before the first `npm run build:admin`).
!apps/admin/dist/
apps/admin/dist/*
!apps/admin/dist/.gitkeep

# Env files (vars/secrets for local tooling; the Worker uses .dev.vars above)
.env
.env.*
!.env.example

# Native folders generated by `expo prebuild` — EAS builds its own
android/
ios/

# OS / editor
.DS_Store
*.log
