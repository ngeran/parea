{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Static web build (`npx expo export --platform web` → dist/), served as a
	// plain assets-only Worker — no code, no bindings. Cloudflare folded Pages
	// into Workers, so this replaces the old `wrangler pages deploy` flow.
	"name": "parea-web",
	"compatibility_date": "2026-08-22",
	"assets": {
		"directory": "dist",
		// SPA fallback: serve index.html for paths that aren't files, so deep
		// links (/welcome) and refreshes work — expo-router picks up the path.
		"not_found_handling": "single-page-application"
	},
	"workers_dev": true,
	"preview_urls": false
}
